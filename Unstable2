local function fetchAndApplyModrinth(slugOrUrl)
    local slug = slugOrUrl
    local urlMatch = string.match(slugOrUrl, "modrinth%.com/resourcepack/([^/%?#]+)")
    if urlMatch then slug = urlMatch end
    slug = string.gsub(slug, "^%s*(.-)%s*$", "%1")
    if slug == "" then error("Empty Modrinth slug/URL") end
    local folderName = string.gsub(slug, "[^%w%-_]", "_")
    local packDir = PACK_ROOT .. "/" .. folderName
    if isfolder and isfolder(packDir) and listfiles and #listfiles(packDir) > 0 then
        local hasFiles = false
        for _, sub in ipairs(listfiles(packDir)) do
            if isfile(sub) or (isfolder(sub) and #listfiles(sub) > 0) then
                hasFiles = true
                break
            end
        end
        if hasFiles then
            local ic, hc = applyPackFromFolder(folderName, slug)
            return ic, hc, true
        end
    end
    local apiUrl = "https://api.modrinth.com/v2/project/" .. HttpService:UrlEncode(slug) .. "/version"
    local verJson = game:HttpGet(apiUrl)
    local versions = HttpService:JSONDecode(verJson)
    if type(versions) ~= "table" or #versions == 0 then
        error("No versions found on Modrinth for: " .. slug)
    end
    local dlUrl = nil
    for _, ver in ipairs(versions) do
        for _, f in ipairs(ver.files or {}) do
            if string.match(f.filename or "", "%.zip$") then
                dlUrl = f.url
                break
            end
        end
        if dlUrl then break end
    end
    if not dlUrl then error("No .zip resource pack file found for: " .. slug) end
    local zipBytes = game:HttpGet(dlUrl)
    local extracted = extractZipTextures(zipBytes, folderName)
    if extracted == 0 then
        error("Downloaded ZIP contained 0 recognized Minecraft textures")
    end
    local ic, hc = applyPackFromFolder(folderName, slug)
    return ic, hc, false
end
