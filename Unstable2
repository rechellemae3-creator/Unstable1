                        d.Image = nextImg
                        if slice then
                            d.ImageRectOffset = slice.offset
                            d.ImageRectSize = slice.size
                        else
                            d.ImageRectOffset = Vector2.new(0, 0)
                            d.ImageRectSize = Vector2.new(0, 0)
