        ksWidgets.badgeStroke.Color = accentColor
    end
    if ksWidgets.badgeLabel then
        ksWidgets.badgeLabel.Text = string.format("MOURIER CLIENT • %d FPS", math.clamp(math.round(smoothFPS), 1, 999))
    end
