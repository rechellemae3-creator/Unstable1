local function aimAnglesForPos(eyePos, blockPt)
    local delta = blockPt - eyePos
    if delta.Magnitude < 1e-5 then
        return Controller.look(), Controller.yaw, Controller.pitch
    end
    local unit = delta.Unit
    local yaw = math.atan2(-unit.X, -unit.Z)
    local pitch = math.asin(math.clamp(unit.Y, -0.999, 0.999))
    return unit, yaw, pitch
end
local function isBlockSolidAt(cell)
    local solid = World.folder and World.folder:FindFirstChild("Solid")
    if not solid then return false end
    local center = (cell + Vector3.new(0.5, 0.5, 0.5)) * BLOCK
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Include
    op.FilterDescendantsInstances = { solid }
    return #Workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(0.8, 0.8, 0.8) * BLOCK, op) > 0
end
local function isCellOccupiedForRail(cell)
    if not World.folder then return false end
    local folders = {}
    for _, name in ipairs({"Solid", "Webs", "Rails"}) do
        local f = World.folder:FindFirstChild(name)
        if f then table.insert(folders, f) end
    end
    if #folders == 0 then return false end
    local center = (cell + Vector3.new(0.5, 0.5, 0.5)) * BLOCK
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Include
    op.FilterDescendantsInstances = folders
    return #Workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(0.8, 0.8, 0.8) * BLOCK, op) > 0
end
