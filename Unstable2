        vlist(toastHolder, 6)

        -- floating toggle button
        local float = corner(new("TextButton", {
            Position = UDim2.new(0, 10, 0.5, -70), Size = UDim2.fromOffset(42, 42), BackgroundColor3 = C.accent,
            BorderSizePixel = 0, Text = "MC", TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 13,
            ZIndex = 20,
        }, gui), 21)

        local function setVisible(v)
            frame.Visible = v
        end

        hideBtn.MouseButton1Click:Connect(function()
            setVisible(false)
        end)

        float.InputBegan:Connect(function(input)
            if isPointer(input) then
                drag = { kind = "float", start = input.Position, from = float.Position, moved = 0, target = float }
            end
        end)

        table.insert(conns, UIS.InputChanged:Connect(function(input)
            if not drag then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            if drag.kind == "slider" then
                drag.setX(input.Position.X)
            else
                local delta = input.Position - drag.start
                local target = (drag.kind == "float") and float or frame
                if drag.kind == "float" then
                    drag.moved = math.max(drag.moved, math.abs(delta.X) + math.abs(delta.Y))
                end
                target.Position = UDim2.new(
                    drag.from.X.Scale, drag.from.X.Offset + delta.X,
                    drag.from.Y.Scale, drag.from.Y.Offset + delta.Y
                )
            end
        end))

        table.insert(conns, UIS.InputEnded:Connect(function(input)
            if not drag or not isPointer(input) then return end
            local finished = drag
            drag = nil
            if finished.kind == "slider" then
                finished.page.ScrollingEnabled = true
            elseif finished.kind == "float" and finished.moved < 6 then
                setVisible(not frame.Visible)
            end
        end))

        table.insert(conns, UIS.InputBegan:Connect(function(input, processed)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if listening then
                local opt = listening
                listening = nil
                if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
                    opt:SetValue(input.KeyCode.Name)
                elseif opt._render then
                    opt._render()
                end
                return
            end
            if processed then return end
            if input.KeyCode == toggleKey then
                setVisible(not frame.Visible)
                return
            end
            local name = input.KeyCode.Name
            for _, opt in ipairs(keybinds) do
                if opt.Value == name then
                    opt:_run()
                end
            end
        end))

        return Window
    end

    function Lib:GetGui()
        return gui
    end

    function Lib:Track(connection)
        table.insert(conns, connection)
    end

    function Lib:Destroy()
        for _, c in ipairs(conns) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(conns)
        if gui then
            pcall(function() gui:Destroy() end)
            gui = nil
        end
    end

    return Lib
end)()
