        task.spawn(function()
            local ok, err = pcall(function()
                if string.match(selectedLocalPack, "%.zip$") then
                    local raw = readfile(PACK_ROOT .. "/" .. selectedLocalPack)
                    local folderName = string.gsub(selectedLocalPack, "%.zip$", "")
                    extractZipTextures(raw, folderName)
