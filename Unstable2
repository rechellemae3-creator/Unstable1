local function inflateRaw(data, startPos, compSize)
    local endPos = startPos + compSize - 1
    local pos = startPos
    local bitBuf, bitCount = 0, 0
    local function needBits(n)
        while bitCount < n do
            local b = (pos <= endPos) and string.byte(data, pos) or 0
            pos = pos + 1
            bitBuf = bit32.bor(bitBuf, bit32.lshift(b, bitCount))
            bitCount = bitCount + 8
        end
    end
    local function readBits(n)
        if n == 0 then return 0 end
        needBits(n)
        local val = bit32.band(bitBuf, bit32.lshift(1, n) - 1)
        bitBuf = bit32.rshift(bitBuf, n)
        bitCount = bitCount - n
