                end
                local litLens, distLens = {}, {}
                for i = 0, hlit - 1 do litLens[i] = allLens[i] end
                for i = 0, hdist - 1 do distLens[i] = allLens[hlit + i] end
                litTree, litMax = buildHuffman(litLens, hlit)
                distTree, distMax = buildHuffman(distLens, hdist)
            end
            while true do
                local sym = decodeSym(litTree, litMax)
                if sym < 256 then
                    outLen = outLen + 1
