local function scanLocalPacks()
    local vals = {}
    ensureFolder(PACK_ROOT)
    if listfiles and isfolder and isfolder(PACK_ROOT) then
        for _, entry in ipairs(listfiles(PACK_ROOT)) do
            local name = string.match(entry, "([^/\\]+)$")
            if name then
                table.insert(vals, name)
            end
        end
    end
    if #vals == 0 then vals = { "(Drop .zip packs in workspace/MourierPacks)" } end
    return vals
end
localDropdown = Tabs.Packs:AddDropdown("LocalPackDropdown", {
