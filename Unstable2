local function stepSwordAimAssist(dt)
    if not Cfg.SwordAimAssist or not isAlive() then return end
    if UserInputService:GetFocusedTextBox() ~= nil then return end
    local state = Controller.state
    local eye = Controller.eye()
    if not state or state.gliding or not eye then return end
    local held = Hands.held()
    local def = held and Items.def(held)
    if not def or (def.kind ~= "sword" and def.kind ~= "axe" and def.kind ~= "spear") then
        return
    end
    local aimRange = (Cfg.SwordReachSwap and def.kind == "spear") and 4.8 or 4.5
    local target = getClosestTarget(aimRange, tonumber(Cfg.AimAssistFOV) or 70)
    if not target then return end
    local _, targetYaw, targetPitch = getBestAimPointAndAngles(eye, target)
    local dyaw = (targetYaw - Controller.yaw + math.pi) % (2 * math.pi) - math.pi
    local dpitch = math.clamp(targetPitch - Controller.pitch, -math.pi, math.pi)
    local alpha = math.clamp((dt or 0.016) * (tonumber(Cfg.AimAssistSmooth) or 0.28) * 35, 0.01, 0.85)
    Controller.yaw = Controller.yaw + dyaw * alpha
    Controller.pitch = math.clamp(Controller.pitch + dpitch * alpha, -1.52, 1.52)
end
