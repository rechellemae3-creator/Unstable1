local function readU16(s, i)
    local a, b = string.byte(s, i, i + 1)
    return a + b * 256
end
local function readU32(s, i)
    local a, b, c, d = string.byte(s, i, i + 3)
    return a + b * 256 + c * 65536 + d * 16777216
end
local function extractZipTextures(zipBytes, packFolder)
    local n = #zipBytes
    local eocdPos = nil
    for i = n - 21, math.max(1, n - 65557), -1 do
        if string.byte(zipBytes, i) == 0x50 and string.byte(zipBytes, i + 1) == 0x4B
           and string.byte(zipBytes, i + 2) == 0x05 and string.byte(zipBytes, i + 3) == 0x06 then
            eocdPos = i
            break
        end
    end
    if not eocdPos then error("Invalid ZIP archive (no EOCD)") end
    local cdOffset = readU32(zipBytes, eocdPos + 16) + 1
    local totalEntries = readU16(zipBytes, eocdPos + 10)
    local baseDir = PACK_ROOT .. "/" .. packFolder
    ensureFolder(baseDir)
    local extracted = 0
    local p = cdOffset
    for _ = 1, totalEntries do
        if readU32(zipBytes, p) ~= 0x02014B50 then break end
        local method = readU16(zipBytes, p + 10)
        local compSize = readU32(zipBytes, p + 20)
        local nameLen = readU16(zipBytes, p + 28)
        local extraLen = readU16(zipBytes, p + 30)
        local commentLen = readU16(zipBytes, p + 32)
        local localHeaderOff = readU32(zipBytes, p + 42) + 1
        local fileName = string.sub(zipBytes, p + 46, p + 45 + nameLen)
        p = p + 46 + nameLen + extraLen + commentLen
        local subTex = string.match(fileName, "^assets/minecraft/textures/(.+%.png)$")
        if subTex and (
            string.sub(subTex, 1, 5) == "item/" or
            string.sub(subTex, 1, 16) == "gui/sprites/hud/" or
            subTex == "gui/icons.png" or
            subTex == "gui/widgets.png" or
            string.sub(subTex, 1, 9) == "particle/" or
            string.sub(subTex, 1, 11) == "mob_effect/" or
            string.sub(subTex, 1, 6) == "block/"
        ) then
            local lhNameLen = readU16(zipBytes, localHeaderOff + 26)
            local lhExtraLen = readU16(zipBytes, localHeaderOff + 28)
            local dataStart = localHeaderOff + 30 + lhNameLen + lhExtraLen
            local rawPng = nil
            if method == 0 then
                rawPng = string.sub(zipBytes, dataStart, dataStart + compSize - 1)
            elseif method == 8 then
                local okInf, resInf = pcall(inflateRaw, zipBytes, dataStart, compSize)
                if okInf then rawPng = resInf end
            end
            if rawPng and #rawPng > 8 then
                local outPath = baseDir .. "/" .. subTex
                local parentDir = string.match(outPath, "^(.+)/[^/]+$")
                if parentDir then ensureFolder(parentDir) end
                writefile(outPath, rawPng)
                extracted = extracted + 1
                if extracted % 12 == 0 then task.wait() end
            end
        end
    end
    return extracted
end
