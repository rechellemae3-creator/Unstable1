                elseif sym == 256 then
                    break
                else
                    local li = sym - 256
                    local length = LEN_BASE[li] + readBits(LEN_EXTRA[li])
                    local di = decodeSym(distTree, distMax) + 1
                    local dist = DIST_BASE[di] + readBits(DIST_EXTRA[di])
                    for _ = 1, length do
                        outLen = outLen + 1
                        out[outLen] = out[outLen - dist]
                    end
                end
