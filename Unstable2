    local rmbCount = getCPS(rmbClicks, now)
    local wDown = UserInputService:IsKeyDown(Enum.KeyCode.W) or Input.isDown("forward")
    local aDown = UserInputService:IsKeyDown(Enum.KeyCode.A) or Input.isDown("left")
    local sDown = UserInputService:IsKeyDown(Enum.KeyCode.S) or Input.isDown("back")
    local dDown = UserInputService:IsKeyDown(Enum.KeyCode.D) or Input.isDown("right")
    local spaceDown = UserInputService:IsKeyDown(Enum.KeyCode.Space) or Input.isDown("jump")
    local lmbDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or (now - (lmbClicks[#lmbClicks] or 0) < 0.065)
    local rmbDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or (now - (rmbClicks[#rmbClicks] or 0) < 0.065)
    local states = {
        W = wDown,
        A = aDown,
        S = sDown,
        D = dDown,
        LMB = lmbDown,
        RMB = rmbDown,
        SPACE = spaceDown,
    }
    local lerpSpeed = math.clamp((dt or 0.016) * 20, 0, 1)
    local idleBg = Color3.fromRGB(18, 18, 24)
    local idleText = Color3.fromRGB(245, 245, 255)
    local activeText = Color3.fromRGB(15, 15, 20)
    local idleStroke = Color3.fromRGB(85, 85, 105)
    for keyName, isPressed in pairs(states) do
        local w = ksWidgets[keyName]
        if w then
            local targetAlpha = isPressed and 1 or 0
            w.alpha = w.alpha + (targetAlpha - w.alpha) * lerpSpeed
            local a = w.alpha
            w.frame.BackgroundColor3 = idleBg:Lerp(accentColor, a)
            w.frame.BackgroundTransparency = 0.35 - (0.15 * a)
            w.stroke.Color = idleStroke:Lerp( Color3.fromRGB(255, 255, 255), a)
            w.stroke.Transparency = 0.45 - (0.35 * a)
            w.mainLbl.TextColor3 = idleText:Lerp(activeText, a)
            if w.subLbl then
                w.subLbl.TextColor3 = Color3.fromRGB(190, 190, 210):Lerp(activeText, a)
            end
        end
    end
    if ksWidgets.LMB then
        ksWidgets.LMB.frame.Visible = (Cfg.KeystrokesShowCPS ~= false)
        if ksWidgets.LMB.subLbl then
            ksWidgets.LMB.subLbl.Text = string.format("%d CPS", lmbCount)
        end
    end
    if ksWidgets.RMB then
        ksWidgets.RMB.frame.Visible = (Cfg.KeystrokesShowCPS ~= false)
        if ksWidgets.RMB.subLbl then
            ksWidgets.RMB.subLbl.Text = string.format("%d CPS", rmbCount)
        end
    end
