                    safeSetDesc(string.format("Current: %s (%d items, %d HUD/blocks)", selectedLocalPack, ic, hc))
                    safeNotify({ Title = "Local Pack Applied", Content = string.format("%s (%d items, %d HUD/blocks)", selectedLocalPack, ic, hc), Duration = 5 })
